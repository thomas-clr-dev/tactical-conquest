<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="UnitShopPanel" style="flex-grow: 1; background-color: rgba(29, 29, 29, 0.75); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; flex-wrap: nowrap; align-self: auto; justify-content: center; align-items: center; align-content: auto;">
        <ui:GroupBox name="Title" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:Label text="Unit Shop&#10;" name="ShopTitle" style="font-size: 24px; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
        </ui:GroupBox>
        <ui:GroupBox name="BuyBtns" style="align-items: stretch; justify-content: center; width: 75%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:GroupBox name="ScoutShop" style="flex-direction: row; justify-content: space-between; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:Label text="Scout" name="ScoutLabel" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Label text="Cost : 5" name="ScoutPrice" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Button text="Buy 1" name="ScoutBuy" style="color: rgb(255, 255, 255); -unity-font-style: bold; border-left-color: rgb(0, 0, 139); border-right-color: rgb(0, 0, 139); border-top-color: rgb(0, 0, 139); border-bottom-color: rgb(0, 0, 139); background-color: rgb(0, 0, 205); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            </ui:GroupBox>
            <ui:GroupBox name="SoldierShop" style="flex-direction: row; justify-content: space-between; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:Label text="Soldier" name="SoldierLabel" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Label text="Cost : 10" name="SoldierPrice" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Button text="Buy 1" name="SoldierBuy" style="color: rgb(255, 255, 255); -unity-font-style: bold; border-left-color: rgb(0, 0, 139); border-right-color: rgb(0, 0, 139); border-top-color: rgb(0, 0, 139); border-bottom-color: rgb(0, 0, 139); background-color: rgb(0, 0, 205); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            </ui:GroupBox>
            <ui:GroupBox name="TankShop" style="flex-direction: row; justify-content: space-between; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:Label text="Tank" name="TankLabel" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Label text="Cost : 15" name="TankPrice" style="color: rgb(255, 255, 255); -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center;"/>
                <ui:Button text="Buy 1" name="TankBuy" style="color: rgb(255, 255, 255); -unity-font-style: bold; background-color: rgb(0, 0, 205); border-left-color: rgb(0, 0, 139); border-right-color: rgb(0, 0, 139); border-top-color: rgb(0, 0, 139); border-bottom-color: rgb(0, 0, 139); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            </ui:GroupBox>
        </ui:GroupBox>
        <ui:GroupBox name="SubCancBtns" style="flex-direction: row; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:Button text="Confirm" name="Submit" style="background-color: rgb(34, 139, 34); border-left-color: rgb(0, 100, 0); border-right-color: rgb(0, 100, 0); border-top-color: rgb(0, 100, 0); border-bottom-color: rgb(0, 100, 0); font-size: 18px; color: rgb(255, 255, 255); -unity-font-style: bold; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
            <ui:Button text="Cancel" name="Cancel" style="font-size: 18px; background-color: rgb(178, 34, 34); border-left-color: rgb(139, 0, 0); border-right-color: rgb(139, 0, 0); border-top-color: rgb(139, 0, 0); border-bottom-color: rgb(139, 0, 0); -unity-font-style: bold; color: rgb(255, 255, 255); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
